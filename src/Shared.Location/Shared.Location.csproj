<Project Sdk="Microsoft.NET.Sdk">

  <!-- Windows SDK target for the Windows location API (Windows.Devices.Geolocation). -->
  <PropertyGroup>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <RootNamespace>Shared.Location</RootNamespace>
    <Description>Current position from the Windows location service, a serial NMEA GPS or a typed position; shared by Field Toolkit and Field Map.</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- GPS receivers that appear as a COM port (NMEA). -->
    <PackageReference Include="System.IO.Ports" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Shared\Shared.csproj" />
    <ProjectReference Include="..\Shared.Core\Shared.Core.csproj" />
  </ItemGroup>

</Project>
