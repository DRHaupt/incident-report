<Project Sdk="Microsoft.NET.Sdk">

  <!-- Platform-neutral map drawing (Skia), shared by the Windows app and the Linux tests that render the sample region. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>FieldMap.Map</RootNamespace>
    <Description>Draws Field Map frames with SkiaSharp: base map tiles, layers, drawings, route, GPS and overlays.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="SkiaSharp" Version="3.119.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FieldMap.Core\FieldMap.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Shared.Core" />
    <Using Include="Shared.Core.Geo" />
    <Using Include="FieldMap.Core.Geo" />
    <InternalsVisibleTo Include="FieldMap.Tests" />
  </ItemGroup>

</Project>
