<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AssemblyName>FieldToolkit</AssemblyName>
    <RootNamespace>FieldToolkit</RootNamespace>
    <Product>Field Toolkit</Product>
    <AssemblyTitle>Field Toolkit</AssemblyTitle>
    <Version>0.1.0</Version>
    <Company>Field Toolkit</Company>
    <Copyright>Copyright © 2026</Copyright>
    <ApplicationIcon>Resources\app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\*.png;Resources\*.ico" LogicalName="FieldToolkit.Resources.%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <!-- Content stays as editable files next to the executable (also with single-file publish). -->
    <None Include="Content\**\*" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Shared.Core" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="FieldToolkit.UiTests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Shared\Shared.csproj" />
    <ProjectReference Include="..\FieldToolkit.Core\FieldToolkit.Core.csproj" />
    <ProjectReference Include="..\Shared.Core\Shared.Core.csproj" />
    <ProjectReference Include="..\Shared.Location\Shared.Location.csproj" />
  </ItemGroup>

</Project>
