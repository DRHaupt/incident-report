      "lines": [
        { "key": "M", "meaning": "Major incident declared? (or standby)" },
        { "key": "E", "meaning": "Exact location (grid reference / what3words / landmarks)" },
        { "key": "T", "meaning": "Type of incident" },
        { "key": "H", "meaning": "Hazards – present and potential" },
        { "key": "A", "meaning": "Access – routes in and out, rendezvous point" },
